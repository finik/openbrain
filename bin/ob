#!/usr/bin/env python3
"""Open Brain CLI — REST + MCP capture. Used by dreaming (no Claude MCP required)."""

from __future__ import annotations

import argparse
import json
import os
import ssl
import sys
import urllib.error
import urllib.parse
import urllib.request


def ssl_context() -> ssl.SSLContext:
    ctx = ssl.create_default_context()
    for candidate in (
        os.environ.get("SSL_CERT_FILE"),
        os.environ.get("REQUESTS_CA_BUNDLE"),
    ):
        if candidate and os.path.exists(candidate):
            ctx.load_verify_locations(candidate)
            return ctx
    try:
        import certifi

        ctx.load_verify_locations(certifi.where())
    except Exception:
        pass
    return ctx


def die(msg: str, code: int = 1) -> None:
    print(msg, file=sys.stderr)
    raise SystemExit(code)


def env() -> tuple[str, str]:
    url = os.environ.get("OPENBRAIN_URL", "").rstrip("/")
    key = os.environ.get("OPENBRAIN_KEY", "")
    if not url or not key:
        die("OPENBRAIN_URL and OPENBRAIN_KEY must be set (source ~/.openbrain/config.sh)")
    return url, key


def request(method: str, path: str, body: dict | None = None, query: dict | None = None) -> object:
    base, key = env()
    url = f"{base}{path}"
    if query:
        qs = urllib.parse.urlencode({k: v for k, v in query.items() if v is not None})
        if qs:
            url = f"{url}?{qs}"
    data = None if body is None else json.dumps(body).encode()
    req = urllib.request.Request(
        url,
        data=data,
        method=method,
        headers={
            "x-brain-key": key,
            "Accept": "application/json",
            "Content-Type": "application/json",
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=120, context=ssl_context()) as resp:
            raw = resp.read().decode()
            return json.loads(raw) if raw else {}
    except urllib.error.HTTPError as e:
        err = e.read().decode(errors="replace")
        die(f"HTTP {e.code} {method} {path}: {err}")
    except urllib.error.URLError as e:
        die(f"Request failed: {e}")


def mcp_call(name: str, arguments: dict) -> object:
    base, key = env()
    payload = json.dumps(
        {
            "jsonrpc": "2.0",
            "id": 1,
            "method": "tools/call",
            "params": {"name": name, "arguments": arguments},
        }
    ).encode()
    req = urllib.request.Request(
        base,
        data=payload,
        method="POST",
        headers={
            "x-brain-key": key,
            "Content-Type": "application/json",
            "Accept": "application/json, text/event-stream",
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=120, context=ssl_context()) as resp:
            raw = resp.read().decode()
    except urllib.error.HTTPError as e:
        die(f"HTTP {e.code} MCP {name}: {e.read().decode(errors='replace')}")
    except urllib.error.URLError as e:
        die(f"MCP request failed: {e}")

    data = None
    for line in raw.splitlines():
        if line.startswith("data:"):
            data = json.loads(line[5:].strip())
    if data is None:
        try:
            data = json.loads(raw)
        except json.JSONDecodeError:
            die(f"Unparseable MCP response: {raw[:500]}")
    if "error" in data:
        die(f"MCP error: {data['error']}")
    result = data.get("result", data)
    if result.get("isError"):
        text = "".join(
            b.get("text", "") for b in result.get("content", []) if isinstance(b, dict)
        )
        die(text or "MCP tool error")
    texts = [b.get("text", "") for b in result.get("content", []) if isinstance(b, dict)]
    return "\n".join(texts) if texts else result


def read_content(args: argparse.Namespace) -> str:
    if getattr(args, "content_file", None):
        with open(args.content_file, encoding="utf-8") as f:
            return f.read()
    if args.content is not None:
        return args.content
    if not sys.stdin.isatty():
        return sys.stdin.read()
    die("Provide --content, --content-file, or pipe content on stdin")


def fmt_thought(t: dict, i: int | None = None, compact: bool = False) -> str:
    meta = t.get("metadata") or {}
    typ = meta.get("type", "note")
    created = (t.get("created_at") or "")[:19]
    updated = (t.get("updated_at") or "")[:19]
    title = t.get("title") or (t.get("content") or "")[:80]
    prefix = f"{i}. " if i is not None else ""
    head = f"{prefix}[{typ}] {created} — {title} (ID: {t.get('id')})"
    if updated:
        head += f" updated={updated}"
    if compact:
        return head
    content = t.get("content") or ""
    topics = meta.get("topics") or []
    extra = f" topics={topics}" if topics else ""
    return f"{head}{extra}\n{content}"


def cmd_list(args: argparse.Namespace) -> None:
    data = request(
        "GET",
        "/api/thoughts",
        query={
            "limit": str(args.limit),
            "page": str(args.page),
            "type": args.type,
            "days": str(args.days) if args.days is not None else None,
            "order": args.order,
            "order_by": args.order_by,
        },
    )
    if args.json:
        print(json.dumps(data, indent=2))
        return
    thoughts = data.get("thoughts") or []
    print(f"{len(thoughts)} thought(s) (total={data.get('total')}, order={args.order} by {args.order_by})")
    for i, t in enumerate(thoughts, 1):
        print()
        print(fmt_thought(t, i, compact=args.compact))


def cmd_get(args: argparse.Namespace) -> None:
    data = request("GET", f"/api/thoughts/{args.id}")
    if args.json:
        print(json.dumps(data, indent=2))
        return
    print(fmt_thought(data))


def cmd_search(args: argparse.Namespace) -> None:
    data = request(
        "GET",
        "/api/search",
        query={"q": args.query, "limit": str(args.limit), "threshold": str(args.threshold)},
    )
    if args.json:
        print(json.dumps(data, indent=2))
        return
    results = data.get("results") or []
    print(f"{len(results)} result(s) for {args.query!r}")
    for i, t in enumerate(results, 1):
        sim = t.get("similarity")
        extra = f" sim={sim:.3f}" if isinstance(sim, (int, float)) else ""
        print()
        print(fmt_thought(t, i, compact=args.compact) + extra)


def cmd_update(args: argparse.Namespace) -> None:
    content = read_content(args)
    data = request("PATCH", f"/api/thoughts/{args.id}", body={"content": content})
    print(json.dumps(data))


def cmd_delete(args: argparse.Namespace) -> None:
    data = request("DELETE", f"/api/thoughts/{args.id}")
    print(json.dumps(data))


def cmd_capture(args: argparse.Namespace) -> None:
    content = read_content(args)
    result = mcp_call("capture_thought", {"content": content})
    print(result)


def cmd_stats(_: argparse.Namespace) -> None:
    print(mcp_call("thought_stats", {}))


def main() -> None:
    p = argparse.ArgumentParser(prog="ob", description="Open Brain CLI")
    sub = p.add_subparsers(dest="cmd", required=True)

    pl = sub.add_parser("list", help="List thoughts")
    pl.add_argument("--limit", type=int, default=20)
    pl.add_argument("--page", type=int, default=0)
    pl.add_argument("--type", choices=["task", "note"])
    pl.add_argument("--days", type=int)
    pl.add_argument("--order", choices=["asc", "desc"], default="desc")
    pl.add_argument("--order-by", dest="order_by", choices=["created_at", "updated_at"], default="created_at")
    pl.add_argument("--compact", action="store_true")
    pl.add_argument("--json", action="store_true")
    pl.set_defaults(func=cmd_list)

    pg = sub.add_parser("get", help="Get one thought")
    pg.add_argument("id")
    pg.add_argument("--json", action="store_true")
    pg.set_defaults(func=cmd_get)

    ps = sub.add_parser("search", help="Hybrid search")
    ps.add_argument("query")
    ps.add_argument("--limit", type=int, default=5)
    ps.add_argument("--threshold", type=float, default=0.1)
    ps.add_argument("--compact", action="store_true")
    ps.add_argument("--json", action="store_true")
    ps.set_defaults(func=cmd_search)

    pu = sub.add_parser("update", help="Replace thought content")
    pu.add_argument("id")
    pu.add_argument("--content")
    pu.add_argument("--content-file")
    pu.set_defaults(func=cmd_update)

    pd = sub.add_parser("delete", help="Delete a thought")
    pd.add_argument("id")
    pd.set_defaults(func=cmd_delete)

    pc = sub.add_parser("capture", help="Capture a new thought")
    pc.add_argument("--content")
    pc.add_argument("--content-file")
    pc.set_defaults(func=cmd_capture)

    pst = sub.add_parser("stats", help="Thought statistics")
    pst.set_defaults(func=cmd_stats)

    args = p.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
